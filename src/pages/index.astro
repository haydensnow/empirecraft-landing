		</style>

		<script is:inline>
			// Check if we should show holiday effects (Nov 23 - Dec 31)
			function checkHolidayPeriod() {
				const now = new Date();
				const year = now.getFullYear();
				const month = now.getMonth(); // 0-indexed (0 = January, 10 = November, 11 = December)
				const day = now.getDate();

				// Show if November (month 10) day 23 or later, OR December (month 11)
				const isHolidayPeriod = (month === 10 && day >= 23) || (month === 11);

				if (isHolidayPeriod) {
					// Show holiday elements
					const holidayBar = document.getElementById('holiday-bar');
					const snowEffect = document.getElementById('snow-effect');
					const navbar = document.getElementById('main-navbar');

					if (holidayBar) holidayBar.style.display = 'block';
					if (snowEffect) snowEffect.style.display = 'block';

					// Adjust navbar position for announcement bar
					if (navbar) navbar.style.top = '40px';

					// Adjust body padding
					document.body.style.paddingTop = '110px';
				} else {
					// Non-holiday period - use normal spacing
					const navbar = document.getElementById('main-navbar');
					if (navbar) navbar.style.top = '0';
					document.body.style.paddingTop = '70px';
				}
			}

			// Run on page load
			checkHolidayPeriod();

			function copyToClipboard(text, button) {
				navigator.clipboard.writeText(text).then(() => {
					const icon = button.querySelector('.copy-icon');
					const originalIcon = icon.textContent;
					button.classList.add('copied');
					icon.textContent = '✅';

					setTimeout(() => {
						icon.textContent = originalIcon;
						button.classList.remove('copied');
					}, 2000);
				}).catch(err => {
					console.error('Failed to copy:', err);
					alert('Failed to copy to clipboard');
				});
			}

			// Fetch server status
			async function fetchServerStatus(host, versionId, playersId) {
				try {
					const response = await fetch(`https://api.mcsrvstat.us/3/${host}`);
					const data = await response.json();

					const versionEl = document.getElementById(versionId);
					const playersEl = document.getElementById(playersId);

					if (data.online) {
						// Version info
						const version = data.version || 'Unknown';
						versionEl.textContent = version;
						versionEl.classList.remove('loading');
						versionEl.classList.add('server-status-online');

						// Player count
						const players = data.players || { online: 0, max: 0 };
						playersEl.textContent = `${players.online} / ${players.max}`;
						playersEl.classList.remove('loading');
						playersEl.classList.add('server-status-online');
					} else {
						versionEl.textContent = 'Server Offline';
						versionEl.classList.remove('loading');
						versionEl.classList.add('server-status-offline');

						playersEl.textContent = '0 / 0';
						playersEl.classList.remove('loading');
						playersEl.classList.add('server-status-offline');
					}
				} catch (error) {
					console.error('Error fetching server status:', error);
					const versionEl = document.getElementById(versionId);
					const playersEl = document.getElementById(playersId);

					versionEl.textContent = 'Unable to fetch';
					versionEl.classList.remove('loading');

					playersEl.textContent = 'Unable to fetch';
					playersEl.classList.remove('loading');
				}
			}

			// Fetch server icon
			async function fetchServerIcon() {
				try {
					const response = await fetch('https://api.mcsrvstat.us/3/play.empirecraftmc.com');
					const data = await response.json();

					if (data.icon) {
						// Update nav icon
						const iconEl = document.getElementById('server-icon');
						iconEl.src = data.icon;

						// Update favicon
						const favicon = document.querySelector("link[rel*='icon']");
						if (favicon) {
							favicon.href = data.icon;
						} else {
							const newFavicon = document.createElement('link');
							newFavicon.rel = 'icon';
							newFavicon.href = data.icon;
							document.head.appendChild(newFavicon);
						}
					}
				} catch (error) {
					console.error('Error fetching server icon:', error);
				}
			}

			// Slideshow functionality
			let currentSlide = 0;
			const slides = document.querySelectorAll('.slide');
			const slideCount = slides.length;

			function nextSlide() {
				slides[currentSlide].classList.remove('active');
				currentSlide = (currentSlide + 1) % slideCount;
				slides[currentSlide].classList.add('active');
			}

			// Change slide every 5 seconds
			setInterval(nextSlide, 5000);

			// Fetch status for both servers when page loads
			document.addEventListener('DOMContentLoaded', () => {
				fetchServerIcon();
				fetchServerStatus('play.empirecraftmc.com', 'server-version', 'server-players');
				fetchServerStatus('170.205.24.229:25588', 'legacy-version', 'legacy-players');
			});

			// Image modal functions
			function openModal(imgSrc) {
				const modal = document.getElementById('imageModal');
				const modalImg = document.getElementById('modalImage');
				modal.style.display = 'block';
				modalImg.src = imgSrc;
			}

			function closeModal() {
				const modal = document.getElementById('imageModal');
				modal.style.display = 'none';
			}

			// Close modal on ESC key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					closeModal();
				}
			});
		</script>
	</body>
</html>
